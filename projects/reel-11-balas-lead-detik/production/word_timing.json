 "phrases": [
  {
   "text": "Lead lu nanya jam sebelas malam,",
   "start": 0.067,
   "end": 1.78
  },
  {
   "text": "baru dibales besok siang.",
   "start": 2.0,
   "end": 3.3
  },
  {
   "text": "Pas dibales, dia udah beli di kompetitor.",
   "start": 3.767,
   "end": 6.02
  },
  {
   "text": "Lead itu nggak boleh nunggu.",
   "start": 6.533,
   "end": 8.04
  },
  {
   "text": "Nih gue tunjukin simulasinya:",
   "start": 8.933,
   "end": 10.28
  },
  {
   "text": "backend AI agent yang bales lead",
   "start": 10.66,
   "end": 12.48
  },
  {
   "text": "dalam hitungan detik.",
   "start": 12.48,
   "end": 13.62
  },
  {
   "text": "Satu, ada yang komen atau DM nanya harga,",
   "start": 13.94,
   "end": 16.32
  },
  {
   "text": "trigger langsung jalan.",
   "start": 16.633,
   "end": 17.48
  },
  {
   "text": "Dua, AI baca niatnya:",
   "start": 17.967,
   "end": 19.62
  },
  {
   "text": "cuma nanya, atau udah siap beli?",
   "start": 19.967,
   "end": 21.92
  },
  {
   "text": "Yang ini skornya delapan puluh enam,",
   "start": 22.22,
   "end": 24.34
  },
  {
   "text": "lead panas.",
   "start": 24.34,
   "end": 25.18
  },
  {
   "text": "Tiga, AI cek data lead di spreadsheet:",
   "start": 25.9,
   "end": 27.92
  },
  {
   "text": "namanya siapa, pernah order apa.",
   "start": 27.92,
   "end": 30.0
  },
  {
   "text": "Empat, AI nulis balasan yang personal,",
   "start": 30.933,
   "end": 33.02
  },
  {
   "text": "bukan template kaku.",
   "start": 33.32,
   "end": 34.4
  },
  {
   "text": "Lima, balasan kekirim,",
   "start": 34.76,
   "end": 36.02
  },
  {
   "text": "dan lead panas langsung dijadwalin call.",
   "start": 36.02,
   "end": 38.18
  },
  {
   "text": "Semua jalan sendiri, dua puluh empat jam.",
   "start": 38.62,
   "end": 40.88
  },
  {
   "text": "Nggak ada lagi lead yang nunggu.",
   "start": 41.167,
   "end": 42.62
  },
  {
   "text": "Mau sistem kayak gini",
   "start": 43.4,
   "end": 44.24
  },
  {
   "text": "dipasang di bisnis lu?",
   "start": 44.24,
   "end": 45.14
  },
  {
   "text": "Klik link di bio,",
   "start": 45.5,
   "end": 46.2
  },
  {
   "text": "ngobrol langsung sama",
