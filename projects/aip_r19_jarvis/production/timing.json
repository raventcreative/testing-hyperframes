   ],
   "start": 30.8667,
   "dur": 5.5666
  },
  {
   "id": "s09",
   "text": "Suaramu diolah di Mac, tapi permintaan dan tangkapan layar dikirim ke penyedia model.",
   "w0": 87,
   "w1": 99,
   "speech": [
    36.43,
    41.42
