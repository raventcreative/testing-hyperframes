   "start": 13.32,
   "end": 14.42
  },
  {
   "text": "sama bedanya di mana.",
   "start": 14.42,
   "end": 16.02
  },
  {
   "text": "Terus dibikin seratus pembeli.",
   "start": 16.02,
   "end": 17.5
  },
  {
   "text": "Beda kerjaan, beda dompet,",
   "start": 17.8,
   "end": 19.22
  },
  {
   "text": "beda masalah.",
   "start": 19.46,
   "end": 20.16
  },
  {
   "text": "Satu-satu ditanya,",
   "start": 20.59,
   "end": 21.42
  },
  {
   "text": "lu bakal beli ini?",
   "start": 21.82,
   "end": 22.56
  },
  {
   "text": "Yang mau tiga puluh enam,",
   "start": 22.56,
   "end": 23.7
  },
  {
   "text": "yang nggak enam puluh empat.",
   "start": 23.7,
   "end": 25.4
  },
  {
   "text": "Alasannya pakai bahasa mereka sendiri.",
   "start": 25.4,
   "end": 27.48
  },
  {
   "text": "Kemahalan.",
   "start": 27.902,
   "end": 28.42
  },
  {
   "text": "Nggak kebayang hasilnya.",
   "start": 28.78,
   "end": 29.94
  },
  {
   "text": "Dari situ ketahuan,",
   "start": 30.252,
   "end": 31.1
  },
  {
   "text": "apa yang bikin yang nolak tadi jadi mau.",
   "start": 31.44,
   "end": 33.5
  },
  {
   "text": "Baru angkanya dicek:",
   "start": 33.94,
