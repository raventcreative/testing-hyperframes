  {
   "text": "Resep laporan laba rugi, tiga puluh detik. Yuk, masak!",
   "start": 0.08,
   "end": 3.44,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Bahannya tiga: penjualan, modal barang, sama biaya.",
