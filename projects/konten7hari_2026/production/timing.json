   ],
   "cuts": [
    94
   ],
   "start": 37.1,
   "dur": 7.7667
  },
  {
   "id": "s09",
   "text": "Tapi, draf AI mentah itu gampang ketahuan. Di sinilah Claude masuk.",
   "w0": 104,
   "w1": 113,
   "speech": [
    45.14,
    49.04
   ],
   "cuts": [
    111
   ],
   "start": 44.8667,
   "dur": 4.4666
  },
  {
   "id": "s10",
   "text": "Empat. Tempel caption terbaikmu. Claude belajar gaya tulisanmu.",
   "w0": 114,
   "w1": 121,
   "speech": [
    49.6,
    53.16
   ],
   "cuts": [
