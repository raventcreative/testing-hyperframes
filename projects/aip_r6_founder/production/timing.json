   ],
   "start": 25.4667,
   "dur": 3.9
  },
  {
   "id": "s07",
   "text": "CFO-nya bilang: angkanya masuk. Tapi panelnya bilang: belum.",
   "w0": 70,
   "w1": 77,
   "speech": [
    29.42,
    33.34
   ],
   "cuts": [
    72,
