{
 "voice_id": "plgKUYgnlZ1DCNh54DwJ",
 "tags": "auto",
 "duration": 54.24,
 "lines": [
  {
   "text": "Ini peta semua AI agent buat jalanin satu bisnis.",
   "start": 0.08,
   "end": 3.446,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiga puluh agent, dan petanya gratis buat kamu.",
   "start": 3.514,
   "end": 6.492,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Mulainya dari yang udah kamu pakai: WhatsApp, Instagram, marketplace, Google Sheets, kalender, email.",
   "start": 6.628,
   "end": 12.652,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Claude di tengah, membaca semuanya.",
   "start": 12.788,
   "end": 14.966,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Dari situ, tumbuh tujuh departemen.",
   "start": 15.034,
   "end": 17.292,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Penjualan: cari calon pembeli, kirim chat pertama, atur janji temu.",
   "start": 17.428,
   "end": 21.484,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Closing: kirim penawaran, lalu follow-up sampai ada jawaban.",
   "start": 22.196,
   "end": 25.415,
   "tags": "[playful] [excited] [confident]"
  },
  {
   "text": "Marketing: tulis konten, balas tiap komentar.",
   "start": 26.025,
   "end": 28.248,
   "tags": "[playful] [excited]"
  },
  {
   "text": "CS: jawab pelanggan, tandai yang mulai menghilang.",
   "start": 28.427,
   "end": 31.368,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Operasional: urus pesanan dan jadwal tim.",
   "start": 31.547,
   "end": 34.087,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Admin dan keuangan: kirim tagihan, ingetin yang belum bayar.",
   "start": 34.16,
   "end": 37.527,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Analis: kenali calon klien sebelum kamu ketemu.",
   "start": 37.6,
   "end": 40.646,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiap agent cuma pegang satu tugas, alurnya ditulis jelas.",
   "start": 40.714,
   "end": 44.167,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Nggak ada yang dikirim ke pelanggan sebelum kamu setuju.",
   "start": 44.24,
   "end": 46.966,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiap pagi, kamu dapat satu halaman: apa yang beres, apa yang nunggu kamu.",
   "start": 47.034,
   "end": 51.284,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen peta, aku kirim peta lengkapnya lewat DM.",
   "start": 51.356,
   "end": 54.24,
   "tags": "[playful] [excited] [confident]"
  }
 ],
