  {
   "text": "Kuis cepat! Diskon tiga puluh persen, untungnya ikut gede?",
   "start": 0.075,
   "end": 3.88,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Pilihan A: pasti naik. Pilihan B: belum tentu.",
   "start": 4.347,
   "end": 7.846,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kita hitung satu barang. Harga seratus ribu, diskon jadi tujuh puluh ribu.",
   "start": 7.914,
   "end": 12.411,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kurangi modal lima puluh ribu, plus ongkir yang kamu tanggung sepuluh ribu.",
   "start": 12.537,
   "end": 16.653,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Untungnya tinggal sepuluh ribu. Padahal tadinya empat puluh ribu!",
   "start": 16.867,
   "end": 20.486,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "Jawabannya B. Biar untungnya sama, kamu harus jual empat kali lipat.",
   "start": 20.554,
   "end": 25.046,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Cek dulu laporan laba rugi di MasterPajak AI, biar tahu untung aslinya sebelum promo.",
   "start": 25.114,
   "end": 30.166,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 30.234,
   "end": 33.205,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 33.28,
   "end": 35.6,
   "tags": "[playful] [excited] [confident]"
  }
 ],
