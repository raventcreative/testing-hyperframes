 "lines": [
  {
   "text": "Orderan masuk lewat chat terus. Tapi, dicatat di mana?",
   "start": 0.08,
   "end": 3.864,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Mau dua ya, kak. Jadi transfer ya. Ongkirnya berapa?",
   "start": 4.16,
   "end": 7.527,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Kalau cuma numpuk di chat, pesanan gampang kelewat.",
   "start": 8.267,
   "end": 11.465,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Biasain catat tiap pesanan jadi satu baris: tanggal, pesanan, nominal.",
   "start": 11.735,
   "end": 16.172,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Satu pesanan, satu baris. Rapi, dan gampang dicek.",
   "start": 16.308,
   "end": 19.705,
   "tags": "[playful] [excited]"
  },
  {
   "text": "MasterPajak AI bantu menata catatan jualanmu jadi pembukuan yang bisa ditelusuri.",
   "start": 19.975,
   "end": 24.646,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 24.714,
   "end": 27.764,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 27.836,
   "end": 30.0,
   "tags": "[playful] [excited] [confident]"
  }
