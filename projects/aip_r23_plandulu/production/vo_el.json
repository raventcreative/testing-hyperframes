 "lines": [
  {
   "text": "Pernah suruh agent AI benerin satu tombol WhatsApp, malah lima file ikut berubah?",
   "start": 0.075,
   "end": 4.68,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Tukang aja gambar denah dulu, baru bongkar tembok.",
   "start": 5.12,
   "end": 8.407,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Agent AI juga gitu: minta rencananya dulu, baru boleh kerja.",
   "start": 8.48,
   "end": 12.486,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Dua agent open source gratis ini punya mode rencana: Open Code dan Hermes.",
   "start": 12.554,
   "end": 17.12,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Dua-duanya kerja di folder proyekmu, modelnya bebas kamu pilih.",
   "start": 17.353,
   "end": 21.206,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Di Open Code, aktifkan agent Plan: boleh baca, nggak boleh ngedit.",
   "start": 21.274,
   "end": 25.286,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Di Hermes, pakai slash plan: rencananya ditulis ke file, belum dikerjakan.",
   "start": 25.354,
   "end": 30.086,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Cek tiga hal: file yang disentuh, yang dihapus, dan cara ngetesnya.",
   "start": 30.154,
   "end": 34.247,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coret denah itu murah, bongkar tembok itu mahal.",
   "start": 34.32,
   "end": 37.846,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Sudah pas? Baru suruh dia kerjain.",
   "start": 37.914,
   "end": 40.084,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen plan, aku kirim lewat DM.",
   "start": 40.156,
   "end": 42.24,
   "tags": "[playful] [excited] [confident]"
  }
