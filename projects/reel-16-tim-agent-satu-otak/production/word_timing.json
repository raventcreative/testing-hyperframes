   "end": 21.84
  },
  {
   "text": "nyari apa yang lagi jalan di industri,",
   "start": 21.84,
   "end": 23.7
  },
  {
   "text": "sampai update AI terbaru.",
   "start": 23.7,
   "end": 25.54
  },
  {
   "text": "Dan semua kerjaan mereka",
   "start": 25.78,
   "end": 26.98
  },
  {
   "text": "masuk ke satu otak bersama.",
   "start": 26.98,
   "end": 28.66
  },
  {
