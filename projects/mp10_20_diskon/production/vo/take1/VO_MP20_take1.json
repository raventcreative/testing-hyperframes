 "lines": [
  {
   "text": "Kuis cepat! Diskon tiga puluh persen, untungnya ikut gede?",
   "start": 0.08,
   "end": 3.84,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Pilihan A: pasti naik, kan makin laris. Pilihan B: belum tentu.",
   "start": 4.073,
   "end": 9.12,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kita hitung satu barang. Harga seratus ribu, didiskon jadi tujuh puluh ribu.",
   "start": 9.193,
   "end": 13.846,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kurangi modal lima puluh ribu, terus ongkir yang kamu tanggung sepuluh ribu.",
   "start": 13.914,
   "end": 18.004,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Untungnya tinggal sepuluh ribu. Padahal tadinya empat puluh ribu!",
   "start": 18.08,
   "end": 21.687,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "Jawabannya B. Biar untungnya sama, kamu harus jual empat kali lipat.",
   "start": 21.76,
   "end": 26.166,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Cek dulu laporan laba rugi di MasterPajak AI, sebelum pasang promo.",
   "start": 26.234,
   "end": 30.007,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 30.08,
   "end": 33.124,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 33.196,
   "end": 35.6,
   "tags": "[playful] [excited] [confident]"
  }
 ],
