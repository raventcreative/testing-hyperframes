   "start": 35.24,
   "end": 36.36
  },
  {
   "text": "balik modal di berapa orang,",
   "start": 36.36,
   "end": 37.5
  },
  {
   "text": "marginnya berapa.",
   "start": 37.87,
   "end": 38.62
  },
  {
   "text": "Hasil akhirnya cuma dua:",
   "start": 39.047,
   "end": 40.14
  },
  {
   "text": "layak, atau belum layak.",
   "start": 40.52,
   "end": 41.909
  },
  {
   "text": "Orang biasanya baru tau",
   "start": 42.244,
   "end": 43.26
  },
  {
   "text": "setelah duitnya abis.",
   "start": 43.26,
   "end": 44.646
  },
  {
   "text": "Ini tau sebelum keluar sepeser.",
