 "lines": [
  {
   "text": "Hari pertama pakai MasterPajak AI, ngapain aja sih?",
   "start": 0.08,
   "end": 3.6,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Pagi, kamu foto nota belanja, terus unggah lewat aplikasi.",
   "start": 3.913,
   "end": 7.32,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Siang, pesanan masuk, catatan jualannya jadi rapi.",
   "start": 7.738,
   "end": 10.88,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Sore, buka laporan: penjualan, biaya, sampai labanya kelihatan.",
   "start": 11.033,
   "end": 15.446,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Malam, masih ada yang belum jelas? Tanya asisten AI, jawabannya dari datamu sendiri.",
   "start": 15.514,
   "end": 20.326,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Dari foto nota sampai laporan laba rugi, semuanya nyambung di pembukuan MasterPajak AI.",
   "start": 20.394,
   "end": 25.607,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 25.68,
   "end": 28.804,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 28.876,
   "end": 31.04,
   "tags": "[playful] [excited] [confident]"
  }
 ],
