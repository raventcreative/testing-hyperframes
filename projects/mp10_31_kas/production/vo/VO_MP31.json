 "lines": [
  {
   "text": "Laporannya untung, tapi kok uangnya nggak ada?",
   "start": 0.08,
   "end": 3.28,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Bayangin, labanya itu air.",
   "start": 3.731,
   "end": 5.92,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Sebagian jadi stok yang belum laku.",
   "start": 6.153,
   "end": 8.012,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Sebagian masih dana penjualan yang belum cair.",
   "start": 8.148,
   "end": 10.572,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Sebagian kepakai belanja stok lagi.",
   "start": 10.708,
   "end": 12.732,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Yang sampai ke kas, tinggal sedikit.",
   "start": 12.868,
   "end": 14.967,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Untung sama uang di tangan itu beda.",
   "start": 15.04,
   "end": 17.367,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pembukuan MasterPajak AI yang rapi bantu kamu lihat uangmu nyangkut di mana.",
   "start": 17.44,
   "end": 21.846,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 21.914,
   "end": 24.724,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 24.796,
   "end": 27.04,
   "tags": "[playful] [excited] [confident]"
  }
 ],
