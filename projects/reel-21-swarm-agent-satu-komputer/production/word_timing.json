  {
   "text": "Bayangin, satu komputer,",
   "start": 0.0,
   "end": 1.72
  },
  {
   "text": "dua puluh empat agent AI,",
   "start": 1.93,
   "end": 3.4
  },
  {
   "text": "semuanya kerja barengan",
   "start": 3.92,
   "end": 5.12
  },
  {
   "text": "di detik yang sama.",
   "start": 5.12,
   "end": 6.0
  },
  {
   "text": "Gue tunjukin simulasinya.",
   "start": 6.84,
   "end": 8.28
  },
  {
   "text": "Tugasnya: launching produk baru",
   "start": 8.7,
   "end": 10.34
  },
  {
   "text": "di toko online lu.",
   "start": 10.34,
   "end": 11.2
  },
  {
   "text": "Pertama, agent pengatur",
   "start": 12.32,
   "end": 13.72
  },
  {
   "text": "mecah satu tugas gede",
   "start": 13.72,
   "end": 15.04
  },
  {
   "text": "jadi dua puluh empat tugas kecil.",
   "start": 15.04,
   "end": 16.72
  },
  {
   "text": "Terus semuanya jalan paralel.",
   "start": 16.96,
   "end": 18.48
  },
  {
   "text": "Ada yang riset harga kompetitor,",
   "start": 18.78,
   "end": 20.24
  },
  {
   "text": "ada yang nulis deskripsi produk,",
   "start": 20.58,
   "end": 21.88
  },
  {
   "text": "ada yang bikin caption,",
   "start": 22.24,
   "end": 23.02
  },
  {
   "text": "ada yang nyiapin balasan chat.",
   "start": 23.52,
   "end": 24.78
  },
  {
   "text": "Kalau ada yang nyangkut,",
   "start": 25.12,
   "end": 26.12
  },
  {
   "text": "agent pengatur langsung",
   "start": 26.32,
   "end": 27.44
  },
  {
   "text": "oper tugasnya ke agent lain.",
   "start": 27.44,
   "end": 28.66
  },
  {
   "text": "Hasilnya digabung jadi satu paket:",
   "start": 29.8,
   "end": 31.72
  },
  {
   "text": "halaman produk, caption,",
   "start": 31.84,
   "end": 33.24
  },
  {
   "text": "sama jadwal posting.",
   "start": 33.24,
   "end": 34.38
  },
  {
   "text": "Tinggal lu cek.",
   "start": 34.7,
   "end": 35.34
  },
  {
   "text": "Satu tugas gede,",
   "start": 35.52,
   "end": 36.46
  },
  {
   "text": "dua puluh empat agent,",
   "start": 36.645,
   "end": 37.74
  },
  {
   "text": "satu komputer.",
   "start": 37.96,
   "end": 38.76
  },
  {
   "text": "Lu tinggal approve.",
   "start": 39.14,
   "end": 39.74
  },
  {
