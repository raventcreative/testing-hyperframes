 "lines": [
  {
   "text": "Stok numpuk di rak, tapi saldo kok tipis?",
   "start": 0.747,
   "end": 3.76,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Coba balik kardusnya. Isinya uang kamu, yang lagi diam.",
   "start": 3.993,
   "end": 7.76,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Belanja stok itu bukan uang hangus, tapi juga bukan untung.",
   "start": 7.993,
   "end": 11.4,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Itu modal yang nyangkut, dan baru jadi biaya pas barangnya laku.",
   "start": 11.6,
   "end": 15.528,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kalau semuanya langsung dianggap biaya, labamu kelihatan jeblok. Padahal barangnya masih ada.",
   "start": 15.672,
   "end": 20.991,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "MasterPajak AI bantu catat belanja stok di pembukuan, biar laporan laba rugimu kebaca bener.",
   "start": 21.329,
   "end": 26.487,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 26.56,
   "end": 29.604,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 29.676,
   "end": 31.92,
   "tags": "[playful] [excited] [confident]"
  }
 ],
