  {
   "text": "yang emang udah dicari orang.",
   "start": 15.7,
   "end": 17.1
  },
  {
   "text": "Gue tunjukin simulasinya.",
   "start": 17.58,
   "end": 18.7
  },
  {
   "text": "Pertama, intel kompetitor.",
   "start": 19.135,
   "end": 20.72
  },
  {
   "text": "Tiap minggu, dia ngecek",
   "start": 21.309,
   "end": 22.46
  },
  {
   "text": "kompetitor lokal lu yang paling gede:",
   "start": 22.46,
   "end": 24.18
  },
  {
   "text": "penawaran mereka, harga mereka,",
   "start": 24.5,
   "end": 26.2
  },
  {
   "text": "review mereka.",
   "start": 26.62,
   "end": 27.24
  },
  {
   "text": "Terus muncul celah",
   "start": 28.131,
   "end": 29.14
  },
  {
   "text": "yang mereka tinggalin kosong.",
   "start": 29.14,
   "end": 30.38
  },
  {
   "text": "Layanan yang nggak ada yang nawarin.",
   "start": 30.593,
   "end": 32.06
  },
  {
   "text": "Keluhan yang nggak ada yang beresin.",
   "start": 32.41,
   "end": 34.1
  },
  {
   "text": "Nah, di situ lu menang.",
   "start": 34.326,
   "end": 35.92
  },
  {
   "text": "Setelah tau celahnya,",
   "start": 36.949,
   "end": 37.94
  },
  {
   "text": "agent suara pelanggan",
   "start": 38.26,
   "end": 39.2
  },
  {
   "text": "yang nentuin cara ngomongnya.",
   "start": 39.2,
   "end": 40.54
  },
  {
   "text": "Dia baca ratusan review",
   "start": 40.86,
   "end": 42.18
  },
  {
   "text": "dan komentar asli di niche lu,",
   "start": 42.18,
   "end": 43.72
  },
  {
   "text": "dalam bahasa apa pun",
   "start": 43.96,
   "end": 45.26
  },
  {
   "text": "yang dipakai pelanggan lu.",
   "start": 45.26,
   "end": 46.22
  },
  {
   "text": "Terus kasih kata-kata persis",
   "start": 46.767,
   "end": 48.34
  },
  {
   "text": "yang dipakai orang waktu mereka siap beli.",
   "start": 48.34,
   "end": 50.22
  },
  {
   "text": "Copy kayak gini nggak bisa lu karang.",
   "start": 50.55,
   "end": 53.438
  },
  {
   "text": "Berikutnya, radar permintaan lokal",
   "start": 53.438,
   "end": 55.3
  },
  {
   "text": "yang bilang kapan lu harus gerak.",
   "start": 55.3,
   "end": 56.852
  },
  {
   "text": "Dia nunjukin apa yang lagi dicari orang",
   "start": 56.991,
   "end": 59.14
  },
  {
   "text": "di area lu sekarang,",
   "start": 59.14,
   "end": 60.12
  },
  {
   "text": "dan nandain yang naik paling cepat.",
   "start": 60.12,
   "end": 62.099
  },
  {
   "text": "Jadi lu launching di minggu",
   "start": 62.36,
   "end": 63.5
  },
  {
   "text": "permintaan mulai naik,",
   "start": 63.5,
   "end": 64.58
  },
  {
   "text": "bukan dua bulan setelah kompetitor.",
   "start": 64.74,
   "end": 66.36
  },
  {
   "text": "Dan yang ngatur semuanya,",
   "start": 67.338,
   "end": 68.38
  },
  {
   "text": "otak risetnya.",
   "start": 68.73,
   "end": 69.54
  },
  {
   "text": "Tiap Senin, lu terima satu halaman.",
   "start": 70.269,
   "end": 72.14
  },
  {
   "text": "Apa yang berubah di pasar lu,",
   "start": 72.502,
   "end": 73.74
  },
  {
   "text": "apa yang lagi ditanyain pelanggan,",
   "start": 74.08,
   "end": 75.5
  },
  {
   "text": "dan satu penawaran yang harus lu luncurin berikutnya.",
   "start": 75.88,
   "end": 78.46
  },
  {
   "text": "Kompetitor lu nebak.",
   "start": 79.034,
   "end": 80.02
  },
  {
   "text": "Lu tau.",
   "start": 80.46,
   "end": 80.92
  },
  {
   "text": "Mau sistem kayak gini",
   "start": 81.795,
   "end": 82.62
  },
  {
   "text": "dipasang di bisnis lu?",
   "start": 82.62,
   "end": 83.48
  },
  {
   "text": "Klik link di bio,",
   "start": 83.48,
   "end": 84.66
  },
  {
   "text": "ngobrol langsung sama",
   "start": 84.9,
   "end": 85.78
  },
  {
   "text": "tim AIpreneur Automation.",
   "start": 85.78,
   "end": 87.12
  }
 ]
