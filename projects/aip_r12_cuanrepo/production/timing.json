   ],
   "start": 19.9333,
   "dur": 2.4334
  },
  {
   "id": "s06",
   "text": "Terus ganti foto sama teksnya pakai punya klien kamu.",
   "w0": 55,
   "w1": 63,
   "speech": [
    22.448,
