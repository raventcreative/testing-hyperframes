 "lines": [
  {
   "text": "Bisnismu capek bukan karena kurang kerja keras. Semuanya masih nyangkut di kamu.",
   "start": 0.773,
   "end": 5.927,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Solusinya bukan tambah jam kerja, tapi lima sistem.",
   "start": 6.0,
   "end": 9.56,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Satu, penjualan: chat masuk dibalas dan dicatat otomatis.",
   "start": 9.818,
   "end": 13.526,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Dua, pemasaran: draf konten seminggu dibikin AI, kamu tinggal setujui.",
   "start": 13.594,
   "end": 18.166,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiga, keuangan: tiap transaksi langsung masuk rekap.",
   "start": 18.234,
   "end": 21.618,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Empat, rekrutmen: lamaran disaring dulu, kamu wawancara yang cocok.",
   "start": 21.822,
   "end": 25.687,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lima, pengiriman: pelanggan dikabari status pesanannya tanpa nanya.",
   "start": 25.76,
   "end": 29.845,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kalau kelimanya jalan, pendapatan bisa naik, biaya bocor turun.",
   "start": 29.92,
   "end": 33.846,
   "tags": "[playful] [excited] [confident]"
  },
  {
   "text": "Kamu pegang keputusan, yang berulang biar sistem dan AI jalanin.",
   "start": 33.914,
   "end": 37.764,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen sistem, aku kirim lewat DM.",
   "start": 37.836,
   "end": 40.0,
   "tags": "[playful] [excited] [confident]"
  }
 ],
