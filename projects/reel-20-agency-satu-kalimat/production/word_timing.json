   "start": 4.14,
   "end": 4.74
  },
  {
   "text": "kerjaannya udah jalan semua.",
   "start": 5.0,
   "end": 6.18
  },
  {
   "text": "Cek simulasinya.",
   "start": 6.56,
   "end": 7.26
  },
  {
   "text": "Di atas ada agent CEO.",
   "start": 8.02,
   "end": 9.62
  },
  {
   "text": "Tiap malem dia baca bisnisnya,",
   "start": 10.2,
   "end": 11.66
  },
  {
   "text": "terus bagi tugas ke agent lain.",
   "start": 11.94,
   "end": 13.24
  },
  {
   "text": "Agent web bikin nama, logo,",
   "start": 13.62,
   "end": 15.28
  },
  {
   "text": "sama halaman penawaran.",
   "start": 15.6,
   "end": 16.58
  },
  {
   "text": "Agent riset nyari",
   "start": 17.46,
   "end": 18.54
  },
  {
   "text": "dua puluh tujuh klinik kecantikan",
   "start": 18.54,
   "end": 20.04
  },
  {
   "text": "yang layak dipitching.",
   "start": 20.04,
   "end": 21.14
  },
  {
   "text": "Terus agent sales nulis",
   "start": 21.88,
   "end": 23.3
  },
  {
   "text": "dua puluh tujuh email, satu-satu,",
   "start": 23.3,
   "end": 25.42
  },
  {
   "text": "sesuai tiap klinik.",
   "start": 25.42,
   "end": 26.44
  },
  {
   "text": "Tapi nggak ada yang kekirim",
   "start": 27.38,
   "end": 28.66
  },
  {
   "text": "sebelum lu baca.",
   "start": 28.66,
   "end": 29.4
  },
  {
   "text": "Ada satu email yang salah",
   "start": 29.4,
   "end": 31.06
  },
  {
   "text": "nyebut nama klinik, lu coret.",
   "start": 31.06,
   "end": 32.84
  },
  {
   "text": "Tombol kirim tetep di tangan lu.",
   "start": 32.84,
   "end": 34.64
  },
  {
   "text": "Dua puluh enam sisanya,",
   "start": 34.78,
   "end": 35.86
  },
  {
   "text": "tinggal klik kirim.",
   "start": 36.12,
   "end": 37.3
  },
  {
   "text": "Satu kalimat, satu tim agent,",
   "start": 37.72,
   "end": 39.66
  },
  {
   "text": "dan lu yang pegang keputusan terakhir.",
   "start": 40.0,
   "end": 41.68
  },
  {
