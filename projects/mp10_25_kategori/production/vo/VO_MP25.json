 "lines": [
  {
   "text": "Nota biaya usahamu masih campur aduk kayak gini?",
   "start": 0.16,
   "end": 2.84,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Ujung-ujungnya, kamu nggak tahu uangnya paling banyak habis buat apa.",
   "start": 3.185,
   "end": 6.96,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Biar jelas, pisahin per kategori: bahan baku, ongkir, iklan, kemasan, sama operasional.",
   "start": 7.193,
   "end": 13.16,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Di MasterPajak AI, cukup unggah foto notanya lewat aplikasi.",
   "start": 13.433,
   "end": 17.003,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tanggal, kategori, sama nominalnya kecatat, terus masuk ke lacinya masing-masing.",
   "start": 17.477,
   "end": 21.526,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jadi kelihatan, biaya mana yang paling gede.",
   "start": 21.594,
   "end": 24.167,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 24.24,
   "end": 27.364,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 27.436,
   "end": 29.68,
   "tags": "[playful] [excited] [confident]"
  }
 ],
