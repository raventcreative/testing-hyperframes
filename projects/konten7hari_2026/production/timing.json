   ],
   "start": 30.0,
   "dur": 7.1
  },
  {
   "id": "s08",
   "text": "Tiga. Minta 7 konten, Senin sampai Minggu. Hook maksimal 12 kata, 3–5 poin, caption, dan 5 hashtag.",
   "w0": 87,
   "w1": 103,
   "speech": [
    37.3,
