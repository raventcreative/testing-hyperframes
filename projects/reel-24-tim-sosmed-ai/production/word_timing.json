   "end": 13.02
  },
  {
   "text": "Modul satu, ide.",
   "start": 13.72,
   "end": 15.0
  },
  {
   "text": "Dia dengerin call klien lu,",
   "start": 15.42,
   "end": 16.66
  },
  {
   "text": "terus scan postingan teratas di niche lu.",
   "start": 16.9,
   "end": 18.76
  },
  {
   "text": "Bukan yang paling banyak di-like,",
   "start": 19.06,
   "end": 20.52
  },
  {
   "text": "tapi yang paling banyak dikomentarin.",
   "start": 20.52,
   "end": 22.72
  },
  {
   "text": "Soalnya orang cuma komen,",
   "start": 22.72,
   "end": 24.2
  },
  {
   "text": "kalau postingannya kena ke masalah yang nyata.",
   "start": 24.2,
   "end": 26.4
  },
  {
   "text": "Tiap minggu, lu dapet sepuluh ide postingan",
   "start": 26.4,
   "end": 29.16
  },
  {
   "text": "dari apa yang lagi ditanyain pelanggan lu.",
   "start": 29.16,
   "end": 31.16
  },
  {
   "text": "Modul dua, konten.",
   "start": 32.04,
   "end": 33.3
  },
  {
   "text": "Tiap minggu dia nulis tiga postingan teks,",
   "start": 33.7,
   "end": 35.8
  },
  {
   "text": "sama tiga naskah video.",
   "start": 35.8,
   "end": 37.22
  },
  {
   "text": "AI video ngubah naskah itu jadi video pendek,",
   "start": 37.54,
   "end": 40.1
  },
  {
   "text": "dan desain bikin carousel-nya.",
   "start": 40.1,
   "end": 42.18
  },
  {
   "text": "Lu tinggal setujuin,",
   "start": 42.18,
   "end": 43.16
  },
  {
   "text": "terus semuanya tayang di jam terbaik.",
   "start": 43.3,
   "end": 45.16
  },
  {
   "text": "Jadi lu muncul tiap hari,",
   "start": 45.32,
   "end": 46.68
  },
  {
   "text": "tanpa ngabisin hari lu buat bikin konten.",
   "start": 46.94,
   "end": 48.88
  },
  {
   "text": "Modul tiga, leads.",
   "start": 49.58,
   "end": 51.02
  },
  {
   "text": "Dia baca semua komentar dan DM.",
   "start": 51.46,
   "end": 53.32
  },
  {
   "text": "Pas ada yang nanya, gimana cara mulai,",
   "start": 53.32,
   "end": 55.82
  },
  {
   "text": "atau, bisa nggak kerja sama,",
   "start": 55.82,
   "end": 57.38
  },
  {
   "text": "dia tandain sebagai calon pembeli.",
   "start": 57.74,
   "end": 59.54
  },
  {
   "text": "Terus dia kirim voice note pakai suara lu,",
   "start": 59.72,
   "end": 61.76
  },
  {
   "text": "plus link booking.",
   "start": 61.94,
   "end": 62.72
  },
  {
   "text": "Callnya langsung masuk kalender lu.",
   "start": 63.12,
   "end": 64.82
  },
  {
   "text": "Kebanyakan orang baru bales dua hari kemudian.",
   "start": 65.7,
   "end": 67.88
  },
  {
   "text": "Pas itu, calonnya udah booking ke tempat lain.",
   "start": 68.2,
   "end": 70.56
  },
  {
   "text": "Yang ngatur semuanya, brand brain.",
   "start": 71.42,
   "end": 73.22
  },
  {
   "text": "Dia nyambungin postingan, komentar, sama call,",
   "start": 73.56,
   "end": 76.12
  },
  {
   "text": "jadi lu tau postingan mana yang beneran bawa klien.",
   "start": 76.3,
   "end": 78.94
  },
  {
   "text": "Tiap Senin, lu terima satu halaman ringkasan.",
   "start": 79.66,
   "end": 82.2
  },
  {
   "text": "Bukan cuma lebih banyak like.",
   "start": 82.2,
   "end": 83.7
  },
  {
   "text": "Tapi lebih banyak klien.",
   "start": 83.94,
   "end": 85.46
  },
  {
   "text": "Mau sistem kayak gini",
   "start": 85.92,
   "end": 86.92
  },
  {
   "text": "dipasang di bisnis lu?",
   "start": 86.92,
   "end": 87.82
  },
  {
   "text": "Klik link di bio,",
   "start": 88.1,
   "end": 88.98
  },
  {
   "text": "ngobrol langsung sama",
   "start": 89.22,
   "end": 90.08
  },
  {
   "text": "tim AIpreneur Automation.",
