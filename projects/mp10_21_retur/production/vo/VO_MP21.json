 "lines": [
  {
   "text": "Paketnya diretur, tapi penjualannya masih kamu hitung?",
   "start": 0.075,
   "end": 3.24,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Misalnya kamu jual sepuluh paket. Semuanya tercatat jadi penjualan.",
   "start": 3.658,
   "end": 7.607,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Terus dua paket diretur. Barangnya balik, uangnya juga balik ke pembeli.",
   "start": 7.68,
   "end": 12.012,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kalau returnya nggak dicatat, penjualanmu kelihatan lebih gede dari aslinya.",
   "start": 12.148,
   "end": 16.173,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Padahal uang yang beneran masuk nggak segitu.",
   "start": 16.387,
   "end": 18.892,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "Di MasterPajak AI, rekonsiliasi bulanan nyocokin catatan jualan sama uang yang masuk.",
   "start": 19.028,
   "end": 23.927,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jadi retur yang kelewat ketahuan dari selisihnya.",
   "start": 24.0,
   "end": 26.887,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 26.96,
   "end": 29.924,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 29.996,
   "end": 32.16,
   "tags": "[playful] [excited] [confident]"
  }
 ],
