 "lines": [
  {
   "text": "Sebelum stok barang atau bayar iklan, lempar dulu idemu ke warga AI.",
   "start": 0.08,
   "end": 4.16,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Namanya MiroFish, open source, puluhan ribu bintang di GitHub.",
   "start": 4.465,
   "end": 8.406,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kamu unggah dokumen idemu, dia bangun kota digital berisi ribuan warga AI.",
   "start": 8.474,
   "end": 12.96,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiap warga punya kepribadian, ingatan, dan cara bersikap sendiri.",
   "start": 13.193,
   "end": 16.84,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lalu mereka posting, debat, dan saling balas di media sosial tiruan.",
   "start": 17.033,
   "end": 21.058,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Contoh: kopi susu literan, lima puluh lima ribu. Ada yang bilang kemahalan, ada yang tanya awetnya.",
   "start": 21.262,
   "end": 26.807,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Hasilnya laporan, plus kamu bisa ngobrol langsung sama satu warganya.",
   "start": 26.88,
   "end": 30.732,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pasangnya minta Claude Code, kamu tinggal isi API key.",
   "start": 30.868,
   "end": 34.172,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Ingat, ini simulasi, bukan ramalan.",
   "start": 34.308,
   "end": 36.724,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen ide, aku kirim lewat DM.",
   "start": 36.796,
   "end": 38.88,
   "tags": "[playful] [excited] [confident]"
  }
 ],
