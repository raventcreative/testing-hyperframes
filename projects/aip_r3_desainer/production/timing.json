   "dur": 4.5
  },
  {
   "id": "s02",
   "text": "Namanya Instagram Agent Skill. Isinya 13 skill, masing-masing punya tugas sendiri.",
   "w0": 11,
   "w1": 21,
   "speech": [
    4.66,
    9.98
   ],
   "cuts": [
    15,
    18,
    20
   ],
   "start": 4.5,
   "dur": 5.7
  },
  {
   "id": "r1",
   "text": "Yang pertama bikin kaget: dia bedah reel yang lagi naik di niche kamu, terus urutin dari yang paling melonjak.",
   "w0": 22,
   "w1": 40,
   "speech": [
    10.45,
    16.36
   ],
   "cuts": [
    26,
