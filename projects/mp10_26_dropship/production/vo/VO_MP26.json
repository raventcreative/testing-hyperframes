  {
   "text": "Reseller atau dropship itu kayak lari estafet: kebanyakan uangnya cuma numpang lewat.",
   "start": 0.08,
   "end": 5.206,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pembeli bayar seratus ribu, itu omzetmu.",
   "start": 5.274,
   "end": 7.932,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Delapan puluh ribunya langsung kamu oper ke supplier.",
   "start": 8.068,
   "end": 10.807,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Yang tinggal di tanganmu cuma dua puluh ribu. Itu untungnya.",
   "start": 10.88,
   "end": 14.412,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kalau cuma uang masuk yang dicatat, omzet kelihatan kayak untung.",
   "start": 14.548,
   "end": 18.172,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Di MasterPajak AI, catat dua sisinya: dari pembeli dan ke supplier.",
   "start": 18.308,
   "end": 22.726,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jadi laporan laba rugi nunjukin untung aslimu.",
   "start": 22.794,
   "end": 25.607,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 25.68,
   "end": 28.644,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 28.716,
   "end": 30.8,
   "tags": "[playful] [excited] [confident]"
  }
