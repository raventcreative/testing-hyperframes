{
 "voice_id": "plgKUYgnlZ1DCNh54DwJ",
 "tags": "auto",
 "duration": 43.68,
 "lines": [
  {
   "text": "Pengen belajar Claude Code, tapi belum sanggup langganan?",
   "start": 0.075,
   "end": 3.2,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Ada jalan tengahnya: Free LLM API, server kecil gratis di GitHub.",
   "start": 3.44,
   "end": 8.16,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Dia jalan di laptopmu, ngerti format API Claude.",
   "start": 8.538,
   "end": 11.446,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Perintah Claude Code dioper ke jatah gratis model dari Google, Groq, Mistral, dan lainnya.",
   "start": 11.514,
   "end": 16.887,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jadi aplikasinya Claude Code, tapi otaknya bukan Claude.",
   "start": 16.96,
   "end": 20.327,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jatah satu habis, otomatis pindah ke yang lain.",
   "start": 20.4,
   "end": 23.132,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pasang servernya, isi API key gratis dari tiap layanan, lalu satu perintah setup.",
   "start": 23.268,
   "end": 28.166,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jujur ya: kualitasnya beda dari Claude, limit gratisnya juga bisa berubah.",
   "start": 28.234,
   "end": 32.726,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kodemu ikut dikirim ke server penyedia, jadi baca aturannya dan jangan kirim data sensitif.",
   "start": 32.794,
   "end": 38.006,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pakai buat belajar dulu, bukan buat kerjaan klien.",
   "start": 38.074,
   "end": 41.204,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen LLM, aku kirim lewat DM.",
   "start": 41.276,
   "end": 43.68,
   "tags": "[playful] [excited] [confident]"
  }
 ],
