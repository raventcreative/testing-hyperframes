{
 "voice_id": "plgKUYgnlZ1DCNh54DwJ",
 "tags": "auto",
 "duration": 89.2,
 "lines": [
  {
   "text": "Claude, aplikasi buatanku harus ngebut, pelangganku nggak sabar nunggu.",
   "start": 0.22,
   "end": 4.16,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kerjakan dua puluh empat perbaikan ini.",
   "start": 4.453,
   "end": 6.24,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pasang skeleton loading, biar layar nggak pernah kosong.",
   "start": 6.618,
   "end": 9.52,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tampilan berubah duluan, server menyusul kemudian.",
   "start": 9.947,
   "end": 12.72,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jawaban AI muncul kata demi kata, nggak nunggu selesai.",
   "start": 12.953,
   "end": 16.649,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Daftar panjang divirtualisasi, cuma yang kelihatan yang digambar.",
   "start": 16.791,
   "end": 20.487,
   "tags": "[playful] [excited] [confident]"
  },
  {
   "text": "Gambar pakai WebP atau AVIF, file-nya lebih kecil.",
   "start": 20.56,
   "end": 24.087,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Gambar di bawah layar dimuat belakangan.",
   "start": 24.16,
   "end": 26.567,
   "tags": "[playful] [excited]"
  },
  {
   "text": "JavaScript dipecah per halaman, yang dimuat cuma yang perlu.",
   "start": 26.64,
   "end": 30.007,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Script pihak ketiga dimuat setelah halaman siap.",
   "start": 30.08,
   "end": 32.887,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Buang library yang nggak dipakai, unduhannya makin kecil.",
   "start": 32.96,
   "end": 36.087,
   "tags": "[playful] [excited]"
  },
  {
   "text": "File statis lewat CDN, dikirim dari lokasi terdekat.",
   "start": 36.16,
   "end": 39.612,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Aktifkan kompresi Gzip atau Brotli, kiriman jadi lebih ringan.",
   "start": 39.748,
   "end": 43.446,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pakai cache browser, kunjungan berikutnya nggak unduh ulang.",
   "start": 43.514,
   "end": 46.727,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kolom pencarian pakai debounce, cari setelah orang berhenti ngetik.",
   "start": 46.8,
   "end": 50.497,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Cegah request dobel waktu tombol diklik dua kali.",
   "start": 50.686,
   "end": 53.385,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Request yang nggak saling tunggu, jalankan bareng.",
   "start": 53.655,
   "end": 56.007,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kasih batas waktu ke layanan luar, biar nggak ikut macet.",
   "start": 56.08,
   "end": 59.206,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tugas berat lempar ke antrean di belakang layar.",
   "start": 59.274,
   "end": 62.088,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Data yang sering dibuka, simpan di cache seperti Redis.",
   "start": 62.32,
   "end": 65.305,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tambah index di database, biar pencarian nggak periksa semua baris.",
   "start": 65.575,
   "end": 69.132,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Benahi query N plus satu, ambil datanya sekaligus.",
   "start": 69.268,
   "end": 72.487,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Ambil kolom yang perlu aja, bukan semuanya.",
   "start": 72.56,
   "end": 75.218,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Hasil yang banyak dibagi per halaman, pakai pagination.",
   "start": 75.422,
   "end": 78.646,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pakai connection pooling, koneksi database dipakai ulang.",
   "start": 78.709,
   "end": 81.772,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Terakhir, tes di HP murah dan sinyal lemah.",
   "start": 81.908,
   "end": 84.645,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen APP, aku kirim dua puluh empat prompt siap tempel buat Claude lewat DM.",
   "start": 84.72,
   "end": 89.2,
   "tags": "[playful] [excited] [confident]"
  }
 ],
