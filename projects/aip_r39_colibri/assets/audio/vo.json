{
 "voice_id": "plgKUYgnlZ1DCNh54DwJ",
 "tags": "auto",
 "duration": 63.44,
 "lines": [
  {
   "text": "Model AI raksasa sekarang bisa jalan di PC kamu sendiri.",
   "start": 0.08,
   "end": 3.6,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Bahkan ada yang mulai dari RAM delapan giga.",
   "start": 3.833,
   "end": 6.4,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Namanya Colibri, gratis, open source, dan mesinnya mungil.",
   "start": 6.705,
   "end": 10.091,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kartu grafis? Opsional, nggak wajib.",
   "start": 10.217,
   "end": 12.646,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kenapa bisa? Model kayak gini isinya banyak ahli kecil.",
   "start": 12.714,
   "end": 16.326,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiap kata, cuma sedikit ahli yang kerja.",
   "start": 16.394,
   "end": 18.807,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Bagian yang selalu kepakai, disimpan di RAM.",
   "start": 18.88,
   "end": 21.207,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Ahli sisanya nunggu di SSD, dipanggil pas dibutuhkan.",
   "start": 21.28,
   "end": 24.727,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Yang sering dipanggil nempel di RAM atau GPU, makin dipakai makin cepat.",
   "start": 24.8,
   "end": 29.052,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Posisinya cuma ngaruh ke kecepatan, modelnya tetap utuh.",
   "start": 29.188,
   "end": 32.498,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Contohnya DeepSeek V4 Flash, mulai dari RAM enam belas giga.",
   "start": 32.702,
   "end": 36.418,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Model Kimi K3, mulai tiga puluh dua giga.",
   "start": 36.622,
   "end": 39.298,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Model coding dari Qwen, cukup delapan giga.",
   "start": 39.502,
   "end": 41.767,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jalan di Windows, Mac, dan Linux.",
   "start": 41.84,
   "end": 44.007,
   "tags": "[playful] [excited]"
  },
  {
   "text": "File Start Here ngecek PC kamu, terus milihin modelnya.",
   "start": 44.08,
   "end": 47.366,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Habis itu, chat-nya langsung kebuka di browser.",
   "start": 47.434,
   "end": 50.086,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tapi jujur, model besar jalannya pelan, dan makan SSD ratusan giga.",
   "start": 50.154,
   "end": 54.727,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jadi buat nyobain AI besar, cukup PC sendiri plus SSD yang lega.",
   "start": 54.8,
   "end": 58.885,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen COLIBRI, aku kirim link-nya plus tabel model per ukuran RAM lewat DM.",
   "start": 58.96,
   "end": 63.44,
   "tags": "[playful] [excited] [confident]"
  }
 ],
