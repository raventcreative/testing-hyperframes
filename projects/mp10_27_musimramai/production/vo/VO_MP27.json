 "lines": [
  {
   "text": "Musim ramai belanja, pesanan datang kayak badai.",
   "start": 0.08,
   "end": 3.76,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Paket numpuk, nota nyelip, catatannya ditunda terus.",
   "start": 4.707,
   "end": 8.64,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Begitu sepi, baru kepikiran: untungnya berapa?",
   "start": 8.94,
   "end": 11.96,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Kuncinya: catat tiap hari, sebentar aja.",
   "start": 12.16,
   "end": 15.206,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lima menit, sebelum tutup toko.",
   "start": 15.274,
   "end": 17.145,
   "tags": "[playful] [excited]"
  },
  {
   "text": "MasterPajak AI bantu ngejar ramainya: unggah foto nota, jadi pembukuan yang rapi.",
   "start": 17.415,
   "end": 22.252,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Untungnya berapa? Tanya asisten AI, jawabannya dari catatanmu.",
   "start": 22.388,
   "end": 26.326,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 26.394,
   "end": 29.444,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 29.516,
   "end": 31.76,
   "tags": "[playful] [excited] [confident]"
  }
 ],
