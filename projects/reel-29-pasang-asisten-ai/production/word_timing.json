  },
  {
   "text": "pakai dua belas kriteria,",
   "start": 20.34,
   "end": 21.64
  },
  {
   "text": "terus nulis ulang bio-nya.",
   "start": 21.9,
   "end": 23.04
  },
  {
   "text": "Ada yang nyusun jadwal seminggu penuh,",
   "start": 23.497,
   "end": 25.12
  },
  {
   "text": "sampai draf caption dan balasan DM.",
   "start": 25.3,
   "end": 27.24
  },
  {
   "text": "Tapi yang paling gila,",
