  {
   "text": "Utang ke supplier, masih kamu simpan di kepala?",
   "start": 0.08,
   "end": 2.84,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Kain belum lunas, kemasan baru bayar separuh, sablon belum dibayar.",
   "start": 3.113,
   "end": 7.52,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lama-lama ada yang lupa.",
   "start": 8.373,
   "end": 10.28,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Pas ditagih, kamu kaget, uangnya udah kepakai.",
   "start": 10.48,
   "end": 13.48,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "Utangnya nggak dicatat, untungmu kelihatan lebih gede dari aslinya.",
   "start": 13.68,
   "end": 17.48,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tenang, pindahin dari kepala ke pembukuan MasterPajak AI.",
   "start": 17.891,
   "end": 21.606,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Ke siapa, berapa, sisanya berapa, semua kecatat dan bisa ditelusuri.",
   "start": 21.674,
   "end": 26.326,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 26.394,
   "end": 29.444,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 29.516,
   "end": 31.76,
   "tags": "[playful] [excited] [confident]"
  }
