{
 "voice_id": "plgKUYgnlZ1DCNh54DwJ",
 "tags": "auto",
 "duration": 66.961,
 "lines": [
  {
   "text": "Lu buka paket baru. Seminggu jalan, yang mesen nol.",
   "start": 0.073,
   "end": 3.84,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lapak sebelah antrinya panjang.",
   "start": 4.08,
   "end": 6.413,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Bedanya satu: dia tau pasarnya, lu nebak.",
   "start": 6.56,
   "end": 9.623,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Cek simulasinya. Tiga puluh lima agent AI yang jalanin riset pasar lu.",
   "start": 9.749,
   "end": 13.783,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Mereka cuma ngejar tiga jawaban: pelanggan mau apa, kompetitor lewatin apa, dan duitnya di mana.",
   "start": 13.909,
   "end": 19.714,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pertama, agent kompetitor. Dia baca penawaran, harga, sama review tiga lapak paling rame di kota lu.",
   "start": 19.903,
   "end": 25.945,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Keluar dua celah: layanan yang nggak ada yang nawarin, sama keluhan yang nggak ada yang beresin.",
   "start": 26.08,
   "end": 30.572,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kedua, agent suara pelanggan. Empat ratus dua belas review dibaca satu-satu.",
   "start": 30.64,
   "end": 35.465,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Yang dibalikin bukan ringkasan, tapi kata-kata persis yang dipakai orang pas mau beli.",
   "start": 35.6,
   "end": 40.093,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Ketiga, radar permintaan lokal. Dia nandain yang lagi naik di area lu.",
   "start": 40.24,
   "end": 44.413,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Facial malam hari naik enam puluh empat persen. Lu bisa buka duluan, bukan dua bulan setelah kompetitor.",
   "start": 44.64,
   "end": 49.773,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Semuanya ngumpul ke satu otak riset.",
   "start": 50.0,
   "end": 52.016,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Tiap Senin lu terima satu halaman: apa yang berubah, apa yang pelanggan tanyain, sama satu penawaran buat minggu ini.",
   "start": 52.16,
   "end": 58.333,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jadi lu gerak karena tau, bukan karena nebak.",
   "start": 58.48,
   "end": 61.129,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Mau sistem kayak gini dipasang di bisnis lu? Klik link di bio, ngobrol langsung sama tim AIpreneur Automation.",
   "start": 61.241,
   "end": 66.961,
   "tags": "[playful] [excited] [confident]"
  }
 ],
