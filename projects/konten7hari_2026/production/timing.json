   ],
   "cuts": [
    54,
    65
   ],
   "start": 22.0,
   "dur": 8.0
  },
  {
   "id": "s07",
   "text": "Dua. Riset tren. Cari 10 topik yang lagi ramai minggu ini. Sertakan alasan dan sumber, pilih 7 yang terkuat.",
   "w0": 68,
   "w1": 86,
   "speech": [
    30.3,
