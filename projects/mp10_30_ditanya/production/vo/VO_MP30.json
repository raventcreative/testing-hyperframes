 "duration": 32.72,
 "lines": [
  {
   "text": "Ada mitra bisnis nanya: usahamu untung berapa sebulan?",
   "start": 0.08,
   "end": 3.56,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Yang satu bingung, bongkar nota, chat, catatan kececer. Jawabnya: kira-kira.",
   "start": 4.32,
   "end": 10.32,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Yang satu lagi tenang, buka laporan laba rugi: penjualan, biaya, labanya jelas.",
   "start": 10.625,
   "end": 16.178,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Bedanya bukan gede kecilnya usaha, tapi ada datanya atau nggak.",
   "start": 16.382,
   "end": 20.407,
   "tags": "[playful] [excited]"
  },
  {
   "text": "MasterPajak AI bantu nyusun catatan jualan dan biayamu jadi laporan laba rugi, biar kamu bisa jawab pakai data.",
   "start": 20.48,
   "end": 27.287,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 27.36,
   "end": 30.484,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 30.556,
   "end": 32.72,
   "tags": "[playful] [excited] [confident]"
  }
 ],
