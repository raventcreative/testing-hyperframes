 "lines": [
  {
   "text": "Mau pakai AI buat trading saham? Pilih yang berani bilang: jangan dulu.",
   "start": 0.08,
   "end": 4.56,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Namanya Day Trader Skill: sebelas skill Claude gratis, dibagi tiga lapis.",
   "start": 4.8,
   "end": 9.4,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lapis satu nyari: ribuan grafik, berita, sampai laporan keuangan.",
   "start": 9.593,
   "end": 13.926,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Lapis dua ngerencanain: titik masuk, stop loss, dan target.",
   "start": 13.994,
   "end": 17.778,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Plus Time Machine: sepuluh ribu simulasi sisa sesi bursa, sebelum sepeser pun keluar.",
   "start": 17.982,
   "end": 22.892,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Di contohnya, peluang target duluan sama stop loss duluan beda tipis: nyaris lempar koin.",
   "start": 23.36,
   "end": 29.207,
   "tags": "[playful] [excited] [sighs]"
  },
  {
   "text": "Lapis tiga ngerem: batas rugi dijaga, trade yang lewat batas diblokir.",
   "start": 29.28,
   "end": 33.687,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Nggak ada order tanpa persetujuan kamu, dan bawaannya akun latihan.",
   "start": 33.76,
   "end": 37.778,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Datanya saham Amerika, jadi anggap ini alat belajar, bukan jaminan.",
   "start": 37.982,
   "end": 41.858,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pasangnya: tempel link GitHub-nya ke Claude, terus tulis install skill.",
   "start": 42.062,
   "end": 45.684,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen SAHAM, aku kirim lewat DM.",
   "start": 45.756,
   "end": 47.92,
   "tags": "[playful] [excited] [confident]"
  }
 ],
