    58
   ],
   "start": 18.1,
   "dur": 7.3667
  },
  {
   "id": "s06",
   "text": "Contohnya, ide katering makan siang kantor, Rp25.000 per porsi.",
   "w0": 61,
   "w1": 69,
   "speech": [
    25.562,
    29.34
   ],
   "cuts": [
