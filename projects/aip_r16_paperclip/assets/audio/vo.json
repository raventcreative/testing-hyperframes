  {
   "text": "AI agent sekarang bisa dikasih jabatan, atasan, sampai gaji token, kayak karyawan beneran.",
   "start": 0.08,
   "end": 6.28,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "Namanya Paperclip: open source, gratis, dan jalan di komputer kamu sendiri.",
   "start": 6.698,
   "end": 11.2,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kamu tulis satu tujuan, misalnya: toko keripik tembus seratus pesanan online seminggu.",
   "start": 11.493,
   "end": 16.487,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Agent CEO-nya nyusun strategi, kamu setujui, baru tugasnya dibagi ke tim web, konten, dan riset.",
   "start": 16.56,
   "end": 22.6,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Butuh anggota baru? CEO-nya ngajuin rekrut, kamu yang approve.",
   "start": 22.785,
   "end": 26.407,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Agent-nya nggak nyala terus: bangun kalau ada tugas atau jadwal, kerja, lapor, terus tidur lagi.",
   "start": 26.48,
   "end": 32.007,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Token tiap agent kelihatan, dan kalau budget-nya habis, dia otomatis dijeda.",
   "start": 32.08,
   "end": 36.407,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Catatannya: agent-nya tetap pakai API atau langganan AI kamu, jadi ada biayanya. Mulai kecil dulu, dan kamu tetap yang ngawasin.",
   "start": 36.48,
   "end": 44.884,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Komen tim, aku kirim lewat DM.",
   "start": 44.956,
   "end": 46.96,
   "tags": "[playful] [excited] [confident]"
  }
 ],
