 "lines": [
  {
   "text": "Ada uang masuk ke rekening usaha, langsung kamu catat jadi omzet?",
   "start": 0.08,
   "end": 3.72,
   "tags": "[playful] [excited] [curious]"
  },
  {
   "text": "Eh, tunggu. Nggak semua uang masuk itu penjualan.",
   "start": 3.92,
   "end": 7.218,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Ada pinjaman, tambahan modal, sampai uang pribadi.",
   "start": 7.422,
   "end": 10.732,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Pinjaman itu utang, tambahan modal itu setoran. Bukan hasil jualan.",
   "start": 10.868,
   "end": 15.368,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Kalau ikut dihitung omzet, angkanya naik, padahal jualanmu nggak nambah.",
   "start": 15.512,
   "end": 19.48,
   "tags": "[playful] [excited] [surprised]"
  },
  {
   "text": "Di pembukuan MasterPajak AI, uang masuk dicatat sesuai jenisnya, biar omzetmu tetap asli.",
   "start": 19.593,
   "end": 24.967,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Jualan jalan terus, pajaknya AI yang urus.",
   "start": 25.04,
   "end": 28.084,
   "tags": "[playful] [excited]"
  },
  {
   "text": "Coba kalkulator gratis. Link di bio.",
   "start": 28.156,
   "end": 30.4,
   "tags": "[playful] [excited] [confident]"
  }
 ],
